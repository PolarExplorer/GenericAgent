        "pattern": "(?is)\\A(?=.*(?:gpt-image-2|image_gen|generate_image))(?=.*(?:1536x1024|1024x1536|quality\\s*=\\s*[\\'\\\"]?high|high))(?!.*(?:background|subprocess|Popen|thread|poll|while\\s+.*exists|timeout\\s*=\\s*(?:2[4-9][0-9]|[3-9][0-9]{2,}))).*",
        "description": "检测高质量大图生成缺后台/轮询/长timeout的超时风险"
