      "id": "C051",
      "name": "docx 图片必须读取为 Buffer 不能传路径",
      "category": "office",
      "priority": "medium",
      "source": "office_doc_sop",
      "description": "创建 docx 插图时必须 fs.readFileSync 读成 Buffer，不能传路径字符串。",
      "detection": {
        "type": "code_pattern",
        "pattern": "(?is)(?:ImageRun|Media\\.addImage).*\\bdata\\s*[:=]\\s*[\\'\\\"][^\\'\\\"]+\\.(?:png|jpe?g|gif|webp)[\\'\\\"]",
        "scope": "exec_only",
        "description": "检测 docx 图片 data 直接传路径字符串而非 Buffer"
      },
      "enabled": true
    },
    {
      "id": "C052",
      "name": "ReportLab 中文 PDF 必须注册中文字体",
      "category": "office",
      "priority": "medium",
      "source": "office_doc_sop",
      "description": "用 reportlab 生成中文 PDF 时必须注册 TTFont，否则中文乱码。",
      "detection": {
        "type": "code_pattern",
        "pattern": "(?is)reportlab(?!.*(?:TTFont|pdfmetrics\\.registerFont|registerFont)).*(?:中文|Chinese|CJK|SimSun|SimHei|微软雅黑|Microsoft YaHei|NotoSansCJK)",
        "scope": "exec_only",
        "description": "检测 ReportLab 中文 PDF 相关代码未注册中文字体"
      },
      "enabled": true
    },
    {
      "id": "C053",
      "name": "subagent 启动后第一步必须读取 context.json",
      "category": "delegation",
      "priority": "high",
      "source": "subagent.md",
      "description": "subagent 启动后第一步读取 context.json，所有文件操作使用其中绝对路径。",
      "detection": {
        "type": "manual"
      },
      "enabled": true
    },
    {
      "id": "C054",
      "name": "主 agent 必须观察 subagent 输出并必要时纠偏",
      "category": "delegation",
      "priority": "medium",
      "source": "subagent.md",
      "description": "subagent 运行时主 agent 应读 output 观察进度，必要时用干预文件纠偏，禁止无脑长 sleep。",
      "detection": {
        "type": "manual"
      },
      "enabled": true
    }
  ],
