    {
      "id": "R060",
      "name": "飞书 CLI 在 Windows 必须 shell=True",
      "category": "tooling",
      "priority": "medium",
      "source": "global_mem.txt",
      "description": "调用 lark-cli 时 Windows 需 subprocess.run(..., shell=True) 才能识别 .cmd。",
      "detection": {
        "type": "code_pattern",
        "pattern": "(?:subprocess|Popen)\\s*(?:\\.\\w+)?\\s*\\(.*lark(?!.*shell\\s*=\\s*True)",
        "scope": "exec_only",
        "description": "飞书CLI在Windows必须shell=True"
      },
      "enabled": true
    },
    {
      "id": "R061",
      "name": "连续>=3轮执行类子任务必须委托 subagent",
      "category": "分发纪律",
      "priority": "high",
      "source": "RULES #14",
      "description": "连续>=3轮主Agent直接执行编码/信息收集类工具调用而未委托subagent，视为违规。",
      "detection": {
        "type": "subagent_delegation_guard",
        "threshold": 3,
        "description": "检测连续>=3轮 coding/info-gathering 工具直执且未委托subagent"
      },
      "enabled": true
    },
    {
      "id": "R062",
      "name": "透明背景图片生成需降级 gpt-image-1.5",
      "category": "image",
      "priority": "low",
      "source": "global_mem.txt",
      "description": "gpt-image-2 工具链默认用于图片生成；透明背景场景需降级 gpt-image-1.5。",
      "detection": {
        "type": "code_pattern",
        "pattern": "(?is)(?:gpt-image-2.*(?:transparent|透明|alpha|背景透明)|(?:transparent|透明|alpha|背景透明).*gpt-image-2)",
        "scope": "tool_args",
        "description": "检测透明背景图片仍使用 gpt-image-2"
      },
      "enabled": true
    },
