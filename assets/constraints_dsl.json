      "check_type": "pattern_forbidden",
      "params": {
        "scope": "tool_args",
        "pattern": "(?:api_key|secret_key|password|token)\\s*=\\s*['\\\"][A-Za-z0-9_\\-]{16,}",
        "description": "检测硬编码密钥/token（≥16字符的字面值赋值）"
      }
    },
    {
      "id": "REG-C021",
      "name": "git push 不自动执行，等用户明确指令",
