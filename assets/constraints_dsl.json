{
  "_meta": {
    "version": "1.0",
    "description": "DSL约束定义 — 并行层，补充ga_audit已有检测",
    "engine": "ga_constraint_engine.py"
  },
  "constraints": [
    {
      "id": "MISSING-PLAN-WORKDIR",
      "name": "规划任务必须先创建工作目录",
      "source": "memory/plan_sop.md:6",
      "check_type": "precondition",
      "params": {
        "action": {
          "scope": "response",
          "pattern": "(计划|规划|方案|plan|探索|收敛|拆解)"
        },
        "precondition": {
          "lookback": 3,
          "tool_names": [
            "code_run",
            "file_write"
          ]
        }
      }
    },
    {
      "id": "MISSING-PLAN-REREAD",
      "name": "规划执行新步骤前禁止凭记忆，必须重读plan.md",
      "source": "memory/plan_sop.md:181",
      "check_type": "precondition",
      "params": {
        "action": {
          "scope": "response",
          "pattern": "(下一步|继续|开始执行|实施|验证|修改)"
        },
        "precondition": {
          "lookback": 2,
          "tool_names": [
            "file_read"
          ]
        }
      }
    },
    {
      "id": "MISSING-TOOL-DISPATCH-TYPE",
      "name": "工具分发前必须先判定任务类型",
      "source": "memory/tool_dispatch_sop.md:18",
      "check_type": "llm_judge",
      "params": {
        "scope": "response",
        "trigger": "(使用|调用|分发|subagent|Codex|Claude|工具)",
        "criteria": "若响应涉及工具/模型分发决策，是否先明确判定任务属于表达型、工程执行型或信息收集型，并据此选择工具。"
      }
    },
    {
      "id": "MISSING-PS-CAT-TYPE",
      "name": "禁止PowerShell cat/type读取文件，必须file_read",
      "source": "global_mem_insight/RULES",
      "check_type": "pattern_forbidden",
      "params": {
        "scope": "exec_only",
        "pattern": "(?:^|[;&|\\n\\r])\\s*(?:cat|type)\\s+[A-Za-z0-9_./\\\\:-]+",
        "negative_context": "[\"'{}()\\[\\]]|import |def |class |subprocess|os\\."
      }
    },
    {
      "id": "MISSING-VISION-ENUM-WINDOW",
      "name": "视觉/截图前必须先枚举窗口",
      "source": "memory/vision_sop.md / global_mem_insight",
      "check_type": "precondition",
      "params": {
        "action": {
          "scope": "response",
          "pattern": "(?:截图|截屏|screenshot|vision|视觉|OCR|识别屏幕|看(?:一下|看)屏幕)",
          "tool_names": [
            "code_run"
          ]
        },
        "precondition": {
          "lookback": 2,
          "response_pattern": "(?:EnumWindows|枚举窗口|窗口枚举|先枚举窗口|确认目标窗口|窗口句柄)"
        }
      }
    },
    {
      "id": "MISSING-LJQ-ACTIVATE",
      "name": "键鼠/物理模拟前必须激活窗口",
      "source": "memory/ljqCtrl_sop.md:3,41",
      "check_type": "precondition",
      "params": {
        "action": {
          "scope": "response",
          "pattern": "(?:ljqCtrl\\.|物理模拟|键鼠操作|pyautogui\\.\\w+\\()",
          "tool_names": [
            "code_run"
          ]
        },
        "precondition": {
          "lookback": 2,
          "response_pattern": "(activate\\(|激活窗口|前台|窗口已激活|置于前台)"
        }
      }
    },
    {
      "id": "MISSING-CODE-HYPOTHESIS",
      "name": "编码前必须先陈述假设和方案",
      "source": "global_mem_insight/RULES#15",
      "check_type": "llm_judge",
      "params": {
        "scope": "all",
        "trigger": "(file_patch|file_write|修改代码|实现|编码|patch)",
        "criteria": "若本轮进行非trivial编码/代码修改，是否在修改前陈述了关键假设和实施方案；若存在歧义是否先询问。"
      }
    },
    {
      "id": "MISSING-MEM-L0-READ",
      "name": "写长期记忆前必须读META-SOP(L0)",
      "source": "CONSTITUTION #8 / memory_management_sop",
      "check_type": "precondition",
      "params": {
        "action": {
          "tool_names": [
            "file_write",
            "file_patch"
          ],
          "scope": "path_only",
          "pattern": "memory[\\\\/](?:global_mem(?:_insight)?\\.txt|.*_sop\\.md|.*\\.md|.*\\.txt)"
        },
        "precondition": {
          "lookback": 10,
          "tool_names": [
            "file_read"
          ],
          "response_pattern": "(?:META-SOP|memory_management_sop|L0)"
        }
      },
      "severity": "critical",
      "description": "任何file_write/file_patch写入memory下长期记忆文件前，近10轮必须实际读取META-SOP(L0)"
    },
    {
      "id": "REG-C001",
      "name": "禁用 pyautogui",
      "source": "ljqCtrl_sop",
      "check_type": "pattern_forbidden",
      "params": {
        "scope": "exec_only",
        "pattern": "(?:^|[\\n;\\\"'])\\s*(?:import\\s+pyautogui|from\\s+pyautogui)|pyautogui\\.\\w+",
        "negative_context": "(?:pattern\\s*[=:].{0,80}|#.{0,80}|[\\\"'`]\\s*\\+\\s*[\\\"'`])"
      }
    },
    {
